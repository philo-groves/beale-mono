{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@beale/research-agent": [
        "packages/research-agent/src/index.ts"
      ],
      "@beale/research-agent/*": [
        "packages/research-agent/src/*"
      ],
      "@beale/app-server-runtime": [
        "packages/app-server-runtime/src/cli.ts"
      ],
      "@beale/app-server-runtime/protocol": [
        "packages/app-server-runtime/src/protocol.ts"
      ],
      "@beale/app-server-runtime/websocket-protocol": [
        "packages/app-server-runtime/src/protocol.ts"
      ],
      "@beale/app-server-runtime/runtime": [
        "packages/app-server-runtime/src/sessionRuntime.ts"
      ],
      "@beale/app-server-runtime/runtime-services": [
        "packages/app-server-runtime/src/runtime-services.ts"
      ],
      "@beale/app-server-runtime/node-network-compatibility": [
        "packages/app-server-runtime/src/node-network-compatibility.ts"
      ]
    }
  }
}
