{
  "name": "beale-mono",
  "version": "0.9.5",
  "private": true,
  "description": "Beale authorized vulnerability research workbench and app-server research runtime.",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false",
    "clean": "tsc -b --clean",
    "start": "pnpm --filter @beale/app-server start",
    "test": "pnpm run test:fast",
    "test:fast": "pnpm run test:runtime:fast && pnpm run test:app-server && pnpm run test:desktop",
    "test:integration": "pnpm run test:runtime:integration && pnpm run test:desktop:integration",
    "test:all": "pnpm run test:fast && pnpm run test:integration",
    "test:runtime:fast": "tsc -b && node --import ./tests/test-environment.mjs --test tests/*.test.mjs",
    "test:runtime:integration": "tsc -b && node --import ./tests/test-environment.mjs --test tests/*.integration.mjs",
    "test:runtime:all": "tsc -b && node --import ./tests/test-environment.mjs --test tests/*.test.mjs tests/*.integration.mjs",
    "test:desktop": "pnpm --filter @beale/desktop test",
    "test:desktop:integration": "pnpm --filter @beale/desktop test:integration",
    "typecheck:desktop": "pnpm --filter @beale/desktop typecheck",
    "dev:desktop": "pnpm --filter @beale/desktop dev",
    "build:desktop": "pnpm --filter @beale/desktop build",
    "start:desktop": "pnpm --filter @beale/desktop start",
    "package:desktop": "pnpm build && pnpm --filter @beale/desktop package",
    "test:app-server": "pnpm --filter @beale/app-server test",
    "release:check": "node scripts/release-version.mjs check && node --test scripts/check-release-artifacts.test.mjs",
    "release:version": "node scripts/release-version.mjs set",
    "release:verify": "pnpm release:check && pnpm build && pnpm typecheck:desktop && pnpm test:all && pnpm build:desktop"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "typescript": "5.9.3",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.7.0"
}
